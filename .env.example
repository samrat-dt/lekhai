# PostgreSQL Database Connection
# Get from Railway, Neon, or other PostgreSQL provider
POSTGRES_URL=postgresql://user:password@host:port/database

# Stripe API Keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Base URL
# Development: http://localhost:3003
# Production: https://yourdomain.com
BASE_URL=http://localhost:3003

# Auth Secret
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_generated_auth_secret_here

# OpenRouter API Key (FREE - Get from https://openrouter.ai/keys)
# Sign up with Google/GitHub and get $1 free credits (enough for 100+ documents)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Encryption Key (for encrypting sensitive data at rest)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_generated_encryption_key_here

# Redis (Optional - for rate limiting and caching)
# Get from Upstash: https://upstash.com
# UPSTASH_REDIS_REST_URL=your_redis_url_here
# UPSTASH_REDIS_REST_TOKEN=your_redis_token_here
